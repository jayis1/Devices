  ; ── Pin Connections ──
  ; ESP32-S3 → UC8151D E-ink (SPI)
  ;   GPIO4  → SCK
  ;   GPIO5  → DIN (MOSI)
  ;   GPIO6  → CS
  ;   GPIO7  → DC
  ;   GPIO8  → RST
  ;   GPIO9  → BUSY
  ;
  ; ESP32-S3 → LSM6DSO (I²C bus)
  ;   GPIO38 → SDA
  ;   GPIO37 → SCL
  ;   GPIO41 → INT1
  ;
  ; ESP32-S3 → MAX98357A (I²S)
  ;   GPIO42 → DIN
  ;   GPIO39 → BCLK
  ;   GPIO40 → LRCLK
  ;
  ; ESP32-S3 → ERM Haptic
  ;   GPIO1  → PWM (via DRV2605L)
  ;
  ; ESP32-S3 → USB-C
  ;   GPIO19 → D-
  ;   GPIO20 → D+
  ;
  ; ESP32-S3 → Battery ADC
  ;   GPIO14 → Voltage divider
  ;
  ; ESP32-S3 → Buttons
  ;   GPIO21 → Dismiss button
  ;   GPIO47 → Snooze button

