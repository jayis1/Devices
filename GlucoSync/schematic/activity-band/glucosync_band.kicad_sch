  ; ── Pin Connections ──
  ; nRF52840 → MAX30101 (I²C bus 1)
  ;   P0.24 → SDA
  ;   P0.25 → SCL
  ;   P0.26 → INT (PPG data ready)
  ;
  ; nRF52840 → LSM6DSO (I²C bus 2)
  ;   P0.27 → SDA
  ;   P0.28 → SCL
  ;   P0.29 → INT1 (data ready)
  ;
  ; nRF52840 → DRV2605L (I²C)
  ;   P0.06 → EN (motor enable)
  ;
  ; nRF52840 → Button
  ;   P0.08 → Tactile (pairing)
  ;
  ; nRF52840 → LED
  ;   P0.09 → WS2812B (status)
  ;
  ; nRF52840 → Battery ADC
  ;   P0.19 → Voltage divider

  (net "VCC_3V" "GND" "VBAT")
  (net "I2C1_SDA" "I2C1_SCL" "PPG_INT")
  (net "I2C2_SDA" "I2C2_SCL" "IMU_INT1")
  (net "ERM_EN" "BTN_PAIR" "STATUS_LED" "BAT_ADC")
)