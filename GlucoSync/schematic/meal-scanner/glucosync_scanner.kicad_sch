  )

  ; ── Pin Connections ──
  ; ESP32-S3 → OV5640 (DVP 8-bit parallel)
  ;   GPIO4-7, 15-18  → D0-D7
  ;   GPIO12 → PCLK, GPIO13 → VSYNC, GPIO14 → HREF
  ;   GPIO8 → SIOC (I²C SCL), GPIO9 → SIOD (I²C SDA)
  ;   GPIO10 → XCLK, GPIO11 → RESET
  ;
  ; ESP32-S3 → Spectral LED MOSFETs
  ;   GPIO21 → Q1 gate (White)
  ;   GPIO38 → Q2 gate (470nm)
  ;   GPIO37 → Q3 gate (660nm)
  ;   GPIO39 → Q4 gate (850nm)
  ;   GPIO40 → Q5 gate (940nm)
  ;
  ; ESP32-S3 → BME280 (I²C)
  ;   GPIO41 → SDA, GPIO42 → SCL
  ;
  ; ESP32-S3 → USB-C
  ;   GPIO19 → D-, GPIO20 → D+
  ;
  ; ESP32-S3 → Battery ADC
  ;   GPIO14 → LiPo voltage divider
  ;
  ; ESP32-S3 → Scan button
  ;   GPIO47 → Tactile button

  (net "VCC_3V3")
  (net "GND")
  (net "VBAT_LIPO")
  (net "CAM_D0" "CAM_D1" "CAM_D2" "CAM_D3" "CAM_D4" "CAM_D5" "CAM_D6" "CAM_D7")
  (net "CAM_PCLK" "CAM_VSYNC" "CAM_HREF" "CAM_XCLK" "CAM_RESET")
  (net "I2C_SCL" "I2C_SDA")
  (net "LED_WHITE_EN" "LED_470_EN" "LED_660_EN" "LED_850_EN" "LED_940_EN")
  (net "USB_DP" "USB_DM")
  (net "BAT_ADC" "SCAN_BTN")
