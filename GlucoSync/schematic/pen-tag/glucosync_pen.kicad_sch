  ; ── Pin Connections ──
  ; nRF52840 → LSM6DSO (I²C)
  ;   P0.24 → SDA
  ;   P0.25 → SCL
  ;   P0.26 → INT1 (data-ready interrupt, triggers at 200 Hz)
  ;
  ; nRF52840 → LED
  ;   P0.06 → WS2812B (status)
  ;
  ; nRF52840 → Button (pairing)
  ;   P0.08 → Tactile
  ;
  ; nRF52840 → Battery ADC
  ;   P0.19 → Voltage divider

